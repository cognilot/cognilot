# Cognilot Extension Configuration Example
# Copy this file as .env and update with your local/production settings

# === API ENDPOINTS ===
# Backend URL (Vercel or Localhost)
VITE_API_BASE_URL=https://cognilot-api.vercel.app
VITE_API_BASE_URL_LOCAL=http://localhost:8000

# Web App Dashboard
VITE_WEB_APP_URL=https://cognilot.com
VITE_WEB_APP_URL_LOCAL=http://localhost:5173

# === AUTHENTICATION ===
# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_client_id_here

